# Copy to .env to override the lab defaults. `docker compose up` works without it.
GANDALF_SERVICE_KEY=dev-only-change-me     # shared secret shop -> engine
GANDALF_IP_HMAC_KEY=dev-only-change-me     # key for the stored IP hash; rotating it unlinks history
SHOP_CARD_HMAC_KEY=dev-only-change-me      # key for the card hash sent to the engine
POSTGRES_PASSWORD=gandalf
SHOP_LAB_MODE=1                            # 1 lets the traffic generators simulate client IP and clock
